# novel2all-go P0 配置模板
# 复制本文件为 configs/.env，填入实际值
# ⚠️ configs/.env 已被 .gitignore 排除，绝对不要提交

# ====== LLM Provider API Keys ======
# 阿里云 DashScope（通义千问）
DASHSCOPE_API_KEY=

# DeepSeek（直连）
DEEPSEEK_API_KEY=

# minimax M3（WRITING 路由专用，最优长文质量）
MINIMAX_API_KEY=

# ====== GitHub 集成 ======
# Personal Access Token，用于：
#   1. CI workflow 拉取 GHCR 镜像
#   2. 本地 AI 助手调 GitHub REST API 查 CI 状态
# Scope 要求：repo + workflow + read:packages
GHCR_TOKEN=

# owner/repo 格式
NOVEL2ALL_REPO=ourvps1688/novel2all-go

# ====== HTTP 服务 ======
HTTP_HOST=0.0.0.0
HTTP_PORT=8000

# ====== 日志 ======
LOG_LEVEL=info           # debug | info | warn | error
LOG_FORMAT=json          # json | text

# ====== 数据库 ======
DB_DRIVER=sqlite3        # sqlite3 (P0) | postgres (P2)
DB_DSN=data/novel2all.db

# ====== Skills（13 个 SKILL.md prompt 模板）======
SKILLS_DIR=internal/skills/assets
SKILLS_MAX_PARALLEL=4

# ====== P1+ 占位 ======
# CHROMADB_URL=           # P1 启用
# CHROMEM_PERSIST_DIR=data/chromem
# GRAPH_BACKEND=memory    # memory | bolt
# EXPORT_TMP_DIR=data/exports

# ====== 生产部署提示 ======
# systemd 环境：在 /etc/novel2all/novel2all-go.env 注入实际值
# Docker 环境：通过 -e 或 secrets mount
# 切勿将本文件复制到生产服务器——用环境变量注入